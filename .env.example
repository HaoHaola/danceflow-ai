MYSQL_DATABASE=danceflow
MYSQL_USER=danceflow_app
MYSQL_PASSWORD=replace-with-local-app-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_HOST_PORT=3307

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra

# Required only for the RAG HTTP endpoint. Use an absolute artifact path.
RAG_ARTIFACT=
RAG_RERANKER_DEVICE=mps

# Optional shell environment variable for the Streamlit process.
DANCEFLOW_API_BASE_URL=http://127.0.0.1:8765
